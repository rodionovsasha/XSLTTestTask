<?xml version="1.0" encoding="UTF-8"?>
<component xmlns:m="urn:math" xmlns:f="urn:feature" xmlns:a="urn:attributes">
  <?preserve instruction?>
  <!-- Features are stored in a different order from their anchors. -->
  <section><math id="m1"/><featureAnchor features="f2"/><math id="m2"/><featureAnchor features="f1"/><featureAnchor features="empty"/><math id="m3"/></section>
  <featureGroup>
    <f:feature id="f1"><wrapper><m:math id="f1a" number="old" a:number="keep"/><math id="f1b"/></wrapper></f:feature>
    <feature id="f2"><m:math id="f2a"/><math id="f2b"/></feature>
    <feature id="empty"/>
  </featureGroup>
  <math id="after">literal {text}</math>
</component>
